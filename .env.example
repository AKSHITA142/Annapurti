# ==========================================
# AnnaPurti (FoodRescue-AI) Root Environment Config
# ==========================================

# -----------------
# Frontend Settings
# -----------------
# Set in frontend/.env or in Vercel Project Settings:
VITE_API_BASE_URL=http://localhost:8000

# -----------------
# Backend Settings
# -----------------
# Set in backend/.env or in hosting provider (e.g. Render/Railway):
PROJECT_NAME=FoodRescue-AI
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./foodrescue.db
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
TOKEN_EXPIRE_HOURS=72
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]

