# ==========================================
# Backend Environment Configuration (Example)
# ==========================================

PROJECT_NAME=FoodRescue-AI
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL URL or SQLite)
DATABASE_URL=sqlite:///./foodrescue.db

# Authentication Secret Key
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
TOKEN_EXPIRE_HOURS=72

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["https://annapurti.vercel.app","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:4173"]

